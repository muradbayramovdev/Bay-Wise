# BayWise environment variables.
# Copy this file to .env and fill in REAL values. The real .env file is git-ignored.
# Prisma also reads these from .env.local (see prisma.config.ts).

# PostgreSQL connection string (e.g. a Supabase project). Required.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# NextAuth / Auth.js — primary secret used to sign JWTs. Required.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret"

# NextAuth legacy fallback secret (used only if AUTH_SECRET is absent). Optional.
NEXTAUTH_SECRET="generate-a-random-secret"

# Full public URL of the app. Required in production.
NEXTAUTH_URL="http://localhost:3000"

# Admin email (optional). NOTE: currently not read by app code; the admin role
# is assigned via scripts/make-admin.ts (which has a hardcoded email).
ADMIN_EMAIL="admin@example.com"

# OpenAI API key (optional — powers AI insights and chat). Leave empty to disable AI.
OPENAI_API_KEY=""
